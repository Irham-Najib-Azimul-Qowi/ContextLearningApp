# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
.pytest_cache/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug & logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# env files
.env
.env.local
.env.*.local
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# python virtual environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# python cache files
__pycache__/
*.py[cod]
*$py.class
*.so

# data pipeline & local embedding model caches
.cache/
huggingface/
*.bin
*.safetensors
*.pt
*.onnx

# large unapproved datasets & temporary pipeline outputs
data-pipeline/datasets/raw/*
!data-pipeline/datasets/raw/.gitkeep
data-pipeline/datasets/processed/*
!data-pipeline/datasets/processed/.gitkeep
data-pipeline/tmp/
tmp/

# local database dumps containing sensitive data
*.dump
*.sql.gz
database_dump.sql
dump.sql
