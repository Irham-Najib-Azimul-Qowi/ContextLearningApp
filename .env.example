# ===================================================
# CONTEXTLEARNING V2 ENVIRONMENT CONFIGURATION
# ===================================================

# --- 1. SUPABASE CONFIGURATION ---
# Public Supabase Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Public Anon Key (safe for client queries, protected by RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key

# Service Role Key (SERVER ONLY - NEVER expose with NEXT_PUBLIC)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# --- 2. GOOGLE GEMINI AI CONFIGURATION ---
# Server-Side Gemini API Key for Centralized AI Provider Manager.
# Teachers and Students NEVER enter this manually.
GEMINI_API_KEY=your-gemini-api-key

# Default active model
GEMINI_MODEL=gemini-2.5-flash

# --- 3. APPLICATION URLS ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- 4. PLATFORM ADMIN BOOTSTRAP ALLOWLIST ---
ADMIN_ALLOWLIST=admin@contextlearning.id,operations@contextlearning.id
