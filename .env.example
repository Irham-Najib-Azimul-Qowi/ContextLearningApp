# ==============================================================================
# PAHAMI V2 (CONTEXTLEARNING) ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env.local for local development.
# DO NOT commit .env or .env.local with real secrets into version control.

# ------------------------------------------------------------------------------
# 1. PUBLIC FRONTEND CONFIGURATION (Safe for browser, protected by RLS)
# ------------------------------------------------------------------------------
# Supabase Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Anonymous / Publishable Key (used by client-side queries)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Public Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 2. NEXT.JS SERVER-SIDE SECRETS (SERVER ONLY - NEVER EXPOSE WITH NEXT_PUBLIC)
# ------------------------------------------------------------------------------
# Supabase Service Role Key (bypasses RLS, used only in server routes & administrative tasks)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Platform Admin Bootstrap Allowlist (comma-separated emails)
ADMIN_ALLOWLIST=admin@contextlearning.id,operations@contextlearning.id

# ------------------------------------------------------------------------------
# 3. AI PROVIDER CONFIGURATION (Server-Side LLM Integration)
# ------------------------------------------------------------------------------
# Server-Side Google Gemini API Key for Centralized AI Provider Manager
GEMINI_API_KEY=your-gemini-api-key

# Default active Gemini model
GEMINI_MODEL=gemini-2.5-flash

# ------------------------------------------------------------------------------
# 4. PYTHON DATA PIPELINE & DIRECT DATABASE ACCESS (Member 1 - Data & RAG Tooling)
# ------------------------------------------------------------------------------
# Direct PostgreSQL connection string to Supabase DB (supports pgvector operations)
# Format: postgresql://postgres.[project-ref]:[db-password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres:your-db-password@db.your-project-ref.supabase.co:5432/postgres

# ------------------------------------------------------------------------------
# 5. EMBEDDING MODEL CONFIGURATION (Offline Data Pipeline - Member 1)
# ------------------------------------------------------------------------------
# Standard offline embedding model used in data-pipeline: intfloat/multilingual-e5-small
# Notice: Online Vercel deployment uses structured_lexical retrieval by default.
# Offline data pipeline embeds passages locally with E5 prefix 'passage: ' and dimensions 384.
EMBEDDING_MODEL_NAME=intfloat/multilingual-e5-small

# Vector dimension matching the PostgreSQL pgvector column definition (384 for E5-small)
EMBEDDING_DIMENSION=384
